<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <IsPackable>true</IsPackable>
    <Version>1.0.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>SayHello.LiquidGlassTheme</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <Description>A reusable liquid-glass Razor Pages theme for ABP Framework.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.MultiTenancy" Version="10.6.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Themes\**\*.cshtml" />
    <EmbeddedResource Include="Views\**\*.cshtml" />
    <EmbeddedResource Include="Localization\LiquidGlassTheme\*.json" />
    <EmbeddedResource Include="wwwroot\**\*.*" />
    <Content Remove="wwwroot\**\*.*" />
    <Content Remove="Localization\LiquidGlassTheme\*.json" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="wwwroot\Themes\LiquidGlass\vendor\NOTICE.txt" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
