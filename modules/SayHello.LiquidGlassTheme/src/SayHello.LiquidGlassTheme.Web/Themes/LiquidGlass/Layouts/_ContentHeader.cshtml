@inject IPageLayout PageLayout
@inject IStringLocalizer<LiquidGlassThemeResource> L
<div class="lgt-page-titles">
    @if (PageLayout.Content.ShouldShowBreadCrumb())
    {
        <nav aria-label="@L["Breadcrumb"]">
            <ol class="breadcrumb">
                @if (PageLayout.Content.BreadCrumb.ShowHome)
                {
                    <li class="breadcrumb-item"><a href="@Url.Content("~/")">@L["Home"]</a></li>
                }
                @foreach (var item in PageLayout.Content.BreadCrumb.Items)
                {
                    <li class="breadcrumb-item">
                        @if (!string.IsNullOrEmpty(item.Url))
                        {
                            <a href="@Url.Content(item.Url)">
                                @if (!string.IsNullOrEmpty(item.Icon)) { <i class="@item.Icon" aria-hidden="true"></i> }
                                @item.Text
                            </a>
                        }
                        else
                        {
                            @item.Text
                        }
                    </li>
                }
                @if (PageLayout.Content.BreadCrumb.ShowCurrent && !string.IsNullOrEmpty(PageLayout.Content.Title))
                {
                    <li class="breadcrumb-item active" aria-current="page">@PageLayout.Content.Title</li>
                }
            </ol>
        </nav>
    }
    @if (!string.IsNullOrWhiteSpace(PageLayout.Content.Title))
    {
        <h1 class="lgt-page-title">@PageLayout.Content.Title</h1>
    }
</div>
