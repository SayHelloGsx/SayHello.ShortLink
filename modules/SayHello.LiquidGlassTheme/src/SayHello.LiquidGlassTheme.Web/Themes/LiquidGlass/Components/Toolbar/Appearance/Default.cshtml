@inject IStringLocalizer<LiquidGlassThemeResource> L
<div class="lgt-appearance" role="group" aria-label="@L["Appearance"]">
    <button type="button" class="lgt-icon-button" data-lgt-mode="system" aria-pressed="false"
            title="@L["SystemMode"]" aria-label="@L["SystemMode"]"><i class="fa fa-desktop" aria-hidden="true"></i></button>
    <button type="button" class="lgt-icon-button" data-lgt-mode="light" aria-pressed="false"
            title="@L["LightMode"]" aria-label="@L["LightMode"]"><i class="fa fa-sun" aria-hidden="true"></i></button>
    <button type="button" class="lgt-icon-button" data-lgt-mode="dark" aria-pressed="false"
            title="@L["DarkMode"]" aria-label="@L["DarkMode"]"><i class="fa fa-moon" aria-hidden="true"></i></button>
</div>
