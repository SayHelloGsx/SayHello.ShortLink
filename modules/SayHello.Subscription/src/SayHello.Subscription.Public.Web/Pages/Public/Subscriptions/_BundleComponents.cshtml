@model PublicSubscriptionBundleDto
<h2 class="h5">@L["Components"]</h2>
@foreach (var component in Model.Items)
{
    <section class="border-top pt-3 mt-3">
        <h3 class="h6">@component.ProductName — @component.PlanName</h3>
        <p class="text-muted">@component.ProductCode · @component.PlanCode</p>
        <partial name="_Entitlements" model="component.Entitlements" />
        <a asp-page="./Plans" asp-route-id="@component.PlanId" class="btn btn-link px-0">@L["Details"]</a>
    </section>
}
