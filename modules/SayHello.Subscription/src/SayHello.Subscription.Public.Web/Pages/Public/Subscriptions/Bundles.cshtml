@page "/subscriptions/bundles/{id:guid?}"
@model BundlesModel
@{
    ViewData["Title"] = Model.Detail?.Name ?? L["Bundles"].Value;
}
<div class="container py-4">
    @if (Model.Detail is { } detail)
    {
        <a asp-page="./Bundles" asp-route-id="">@L["BackToBundles"]</a>
        <h1 class="mt-3">@detail.Name</h1>
        <p class="text-muted">@detail.Code</p>
        <p>@detail.Description</p>
        <p class="text-muted">@L["BundleIntro"]</p>
        <div class="card"><div class="card-body">
            <partial name="_BundleComponents" model="detail" />
        </div></div>
    }
    else
    {
        <h1>@L["Bundles"]</h1>
        <p class="text-muted">@L["CatalogIntro"]</p>
        <p class="text-muted">@L["BundleIntro"]</p>
        <partial name="_CatalogFilters" model="Model" />
        @if (Model.Items.Count == 0)
        {
            <p class="alert alert-info">@L["NoCatalogItems"]</p>
        }
        <div class="row g-4">
            @foreach (var item in Model.Items)
            {
                <div class="col-lg-6"><article class="card h-100"><div class="card-body">
                    <h2 class="h4">@item.Name</h2>
                    <p>@item.Description</p>
                    <partial name="_BundleComponents" model="item" />
                    <a asp-page="./Bundles" asp-route-id="@item.Id" class="btn btn-outline-primary mt-3">@L["Details"]</a>
                </div></article></div>
            }
        </div>
        <partial name="_Pager" model="Model.Pagination" />
    }
</div>
