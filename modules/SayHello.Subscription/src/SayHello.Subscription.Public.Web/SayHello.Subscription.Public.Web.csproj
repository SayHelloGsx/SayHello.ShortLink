<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\..\common.props" />
  <PropertyGroup>
    <RootNamespace>SayHello.Subscription.Public.Web</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.Shared" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Mapperly" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />
    <ProjectReference Include="..\SayHello.Subscription.Public.Application.Contracts\SayHello.Subscription.Public.Application.Contracts.csproj" />
    <EmbeddedResource Include="wwwroot\**\*.*;Pages\**\*.css;Pages\**\*.js;Components\**\*.css;Components\**\*.js" />
    <Content Remove="wwwroot\**\*.*;Pages\**\*.css;Pages\**\*.js;Components\**\*.css;Components\**\*.js" />
  </ItemGroup>
  <Target Name="EnableSubscriptionEmbeddedManifest" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <GenerateEmbeddedFilesManifest Condition="'@(EmbeddedResource)' != ''">true</GenerateEmbeddedFilesManifest>
    </PropertyGroup>
  </Target>
</Project>
