<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\..\common.props" />
  <PropertyGroup>
    <RootNamespace>SayHello.Subscription.Admin.Web</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />
    <ProjectReference Include="..\SayHello.Subscription.Admin.Application.Contracts\SayHello.Subscription.Admin.Application.Contracts.csproj" />
    <ProjectReference Include="..\SayHello.Subscription.Common.Web\SayHello.Subscription.Common.Web.csproj" />
    <EmbeddedResource Include="wwwroot\**\*.*;Pages\**\*.css;Pages\**\*.js;Components\**\*.css;Components\**\*.js" />
    <Content Remove="wwwroot\**\*.*;Pages\**\*.css;Pages\**\*.js;Components\**\*.css;Components\**\*.js" />
  </ItemGroup>
  <Target Name="EnableSubscriptionEmbeddedManifest" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <GenerateEmbeddedFilesManifest Condition="'@(EmbeddedResource)' != ''">true</GenerateEmbeddedFilesManifest>
    </PropertyGroup>
  </Target>
</Project>
