<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssetTargetFallback>$(AssetTargetFallback);portable-net45+win8+wp8+wpa81;</AssetTargetFallback>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
    <RootNamespace>SayHello.ShortLink.Web</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SayHello.ShortLink.Admin.Web\SayHello.ShortLink.Admin.Web.csproj" />
    <ProjectReference Include="..\SayHello.ShortLink.Application.Contracts\SayHello.ShortLink.Application.Contracts.csproj" />
    <ProjectReference Include="..\SayHello.ShortLink.Public.Web\SayHello.ShortLink.Public.Web.csproj" />
  </ItemGroup>

</Project>
