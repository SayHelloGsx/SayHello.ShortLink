@page "/admin/short-links/blocked-domains"
@using Microsoft.Extensions.Localization
@using SayHello.ShortLink.Localization
@model SayHello.ShortLink.Admin.Web.Pages.Admin.ShortLinks.BlockedDomainsModel
@inject IStringLocalizer<ShortLinkResource> L

@{
    ViewData["Title"] = L["BlockedDomains"];
}

<div class="container py-4">
    <h1 class="mb-4">@L["BlockedDomains"]</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="post" asp-page-handler="Create" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-md-4">
                    <label asp-for="NewDomain.Domain" class="form-label">@L["Domain"]</label>
                    <input asp-for="NewDomain.Domain" class="form-control" placeholder="example.com" />
                    <span asp-validation-for="NewDomain.Domain" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NewDomain.Reason" class="form-label">@L["Reason"]</label>
                    <input asp-for="NewDomain.Reason" class="form-control" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">@L["Add"]</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">@L["BlockedDomainImport:Title"]</h2>
            <p class="text-muted">@L["BlockedDomainImport:Description"]</p>
            <pre class="bg-light rounded p-2"><code>Domain,Reason
example.com,Malware
sub.example.org,"Spam, phishing"</code></pre>
            <form method="post"
                  asp-page-handler="Import"
                  enctype="multipart/form-data"
                  class="row g-3 align-items-end">
                <div class="col-md-9">
                    <label asp-for="CsvFile" class="form-label">@L["BlockedDomainImport:File"]</label>
                    <input asp-for="CsvFile"
                           type="file"
                           accept=".csv,text/csv"
                           class="form-control" />
                    <span asp-validation-for="CsvFile" class="text-danger"></span>
                    <div class="form-text">@L["BlockedDomainImport:Limits"]</div>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        <i class="fa fa-upload me-1"></i>@L["BlockedDomainImport:Upload"]
                    </button>
                </div>
            </form>

            @if (Model.ImportResult is not null)
            {
                <div class="alert alert-info mt-4 mb-3">
                    @L[
                        "BlockedDomainImport:Summary",
                        Model.ImportResult.TotalRows,
                        Model.ImportResult.ImportedCount,
                        Model.ImportResult.ExistingCount,
                        Model.ImportResult.DuplicateCount,
                        Model.ImportResult.InvalidCount]
                </div>

                @if (Model.ImportResult.Issues.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle">
                            <thead>
                            <tr>
                                <th>@L["BlockedDomainImport:Row"]</th>
                                <th>@L["Domain"]</th>
                                <th>@L["BlockedDomainImport:IssueType"]</th>
                                <th>@L["BlockedDomainImport:Message"]</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var issue in Model.ImportResult.Issues)
                            {
                                <tr>
                                    <td>@issue.RowNumber</td>
                                    <td>@issue.Domain</td>
                                    <td>@L[$"BlockedDomainImport:IssueType:{issue.Type}"]</td>
                                    <td>@issue.Message</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead>
            <tr>
                <th>@L["Domain"]</th>
                <th>@L["Reason"]</th>
                <th>@L["Status"]</th>
                <th class="text-end">@L["Actions"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Domain</td>
                    <td>@item.Reason</td>
                    <td>@(item.IsActive ? L["Active"] : L["Inactive"])</td>
                    <td class="text-end">
                        <form method="post" asp-page-handler="Toggle" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="reason" value="@item.Reason" />
                            <input type="hidden" name="isActive" value="@item.IsActive" />
                            <input type="hidden" name="concurrencyStamp" value="@item.ConcurrencyStamp" />
                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                @(item.IsActive ? L["Disable"] : L["Activate"])
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Delete" class="d-inline delete-short-link-form">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<abp-script src="/Pages/Admin/ShortLinks/Index.js" />
