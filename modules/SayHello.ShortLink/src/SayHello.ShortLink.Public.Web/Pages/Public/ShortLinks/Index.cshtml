@page "/short-links"
@using Microsoft.Extensions.Localization
@using System.Linq
@using SayHello.ShortLink.Localization
@using SayHello.ShortLink.Public.ShortLinks
@using SayHello.ShortLink.ShortLinks
@model SayHello.ShortLink.Public.Web.Pages.Public.ShortLinks.IndexModel
@inject IStringLocalizer<ShortLinkResource> L

@{
    ViewData["Title"] = L["MyShortLinks"];
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">@L["MyShortLinks"]</h1>
            <p class="text-muted mb-0">@L["MyShortLinks:Description"]</p>
        </div>
        @if (Model.HasNamespacePermission)
        {
            <a asp-page="./Namespaces" class="btn btn-outline-secondary">@L["ManageNamespaces"]</a>
        }
    </div>

    <div class="card shadow-sm mb-4" aria-label="@L["Quota:Usage"]">
        <div class="card-body">
            <h2 class="h5">@L["Quota:Usage"]</h2>
            <span class="me-3">@L["Quota:Used", Model.Capabilities.UsedLinks]</span>
            @if (!Model.Capabilities.IsQuotaGranted)
            {
                <div class="text-warning mt-2" role="status">@L["Quota:NotGranted"]</div>
            }
            else if (Model.Capabilities.IsUnlimited)
            {
                <span>@L["Quota:Unlimited"]</span>
            }
            else
            {
                <span class="me-3">@L["Quota:Limit", Model.Capabilities.MaxLinks!]</span>
                <span>@L["Quota:Remaining", Model.Capabilities.RemainingLinks!]</span>
                @if (Model.Capabilities.MaxLinks == 0)
                {
                    <div class="text-warning mt-2" role="status">@L["Quota:Zero"]</div>
                }
                else if (Model.Capabilities.UsedLinks > Model.Capabilities.MaxLinks)
                {
                    <div class="text-warning mt-2" role="status">@L["Quota:OverLimit"]</div>
                }
                else if (Model.Capabilities.RemainingLinks == 0)
                {
                    <div class="text-warning mt-2" role="status">@L["Quota:Full"]</div>
                }
            }
            @if (!Model.Capabilities.StatisticsEnabled)
            {
                <div class="text-muted mt-2">@L["Statistics:Unavailable"]</div>
            }
            <hr />
            <h3 class="h6">@L["CustomCodeQuota:Usage"]</h3>
            <span class="me-3">@L["Quota:Used", Model.Capabilities.UsedCustomCodes]</span>
            @if (!Model.Capabilities.IsCustomCodeQuotaGranted)
            {
                <div class="text-warning mt-2" role="status">@L["CustomCodeQuota:NotGranted"]</div>
            }
            else if (Model.Capabilities.IsCustomCodeUnlimited)
            {
                <span>@L["Quota:Unlimited"]</span>
            }
            else
            {
                <span class="me-3">@L["Quota:Limit", Model.Capabilities.MaxCustomCodes!]</span>
                <span>@L["Quota:Remaining", Model.Capabilities.RemainingCustomCodes!]</span>
                @if (Model.Capabilities.MaxCustomCodes == 0)
                {
                    <div class="text-warning mt-2" role="status">@L["CustomCodeQuota:Zero"]</div>
                }
                else if (Model.Capabilities.UsedCustomCodes > Model.Capabilities.MaxCustomCodes)
                {
                    <div class="text-warning mt-2" role="status">@L["CustomCodeQuota:OverLimit"]</div>
                }
                else if (Model.Capabilities.RemainingCustomCodes == 0)
                {
                    <div class="text-warning mt-2" role="status">@L["CustomCodeQuota:Full"]</div>
                }
            }
            <hr />
            <h3 class="h6">@L["RootLinkQuota:Usage"]</h3>
            <span class="me-3">@L["Quota:Used", Model.Capabilities.UsedRootLinks]</span>
            @if (!Model.Capabilities.IsRootLinkQuotaGranted)
            {
                <div class="text-warning mt-2" role="status">@L["RootLinkQuota:NotGranted"]</div>
            }
            else if (Model.Capabilities.IsRootLinkUnlimited)
            {
                <span>@L["Quota:Unlimited"]</span>
            }
            else
            {
                <span class="me-3">@L["Quota:Limit", Model.Capabilities.MaxRootLinks!]</span>
                <span>@L["Quota:Remaining", Model.Capabilities.RemainingRootLinks!]</span>
                @if (Model.Capabilities.MaxRootLinks == 0)
                {
                    <div class="text-warning mt-2" role="status">@L["RootLinkQuota:Zero"]</div>
                }
                else if (Model.Capabilities.UsedRootLinks > Model.Capabilities.MaxRootLinks)
                {
                    <div class="text-warning mt-2" role="status">@L["RootLinkQuota:OverLimit"]</div>
                }
                else if (Model.Capabilities.RemainingRootLinks == 0)
                {
                    <div class="text-warning mt-2" role="status">@L["RootLinkQuota:Full"]</div>
                }
            }
            <hr />
            <partial name="_NamespaceQuota" model="Model.Capabilities" />
        </div>
    </div>

    @if (Model.HasCreatePermission)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5">@L["CreateShortLink"]</h2>
                <form method="post"
                      asp-page-handler="Create"
                      id="create-short-link-form"
                      class="row g-3"
                      data-namespace-list-url="@Url.Page(null, "Namespaces")"
                      data-can-create="@Model.CanCreate.ToString().ToLowerInvariant()"
                      data-can-use-namespaces="@Model.CanSelectNamespaces.ToString().ToLowerInvariant()"
                      data-can-create-root="@Model.Capabilities.CanCreateRootLink.ToString().ToLowerInvariant()">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="col-lg-4">
                        <label asp-for="NewLink.TargetUrl" class="form-label">@L["TargetUrl"]</label>
                        <input asp-for="NewLink.TargetUrl" class="form-control" placeholder="https://example.com/path" />
                        <span asp-validation-for="NewLink.TargetUrl" class="text-danger"></span>
                    </div>
                    <div class="col-lg-2">
                        <label asp-for="NewLink.Origin" class="form-label">@L["Origin"]</label>
                        <select asp-for="NewLink.Origin" class="form-select">
                            <option value="">@L["SelectDomain"]</option>
                            @foreach (var domain in Model.Capabilities.Domains)
                            {
                                <option value="@domain.Origin">
                                    @domain.Origin@(domain.IsDefault ? $" ({L["ShortLinkDomains:Default"]})" : string.Empty)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="NewLink.Origin" class="text-danger"></span>
                    </div>
                    <div class="col-lg-4">
                        <label asp-for="NewLink.NamespaceId" class="form-label">@L["Namespace"]</label>
                        <select asp-for="NewLink.NamespaceId"
                                class="form-select"
                                disabled="@(!Model.NewLink.NamespaceId.HasValue && (!Model.CanSelectNamespaces || Model.NewLink.UseRootPath))"
                                aria-describedby="namespace-options-status">
                            <option value="">@L["Namespaces:DefaultOption", Model.Capabilities.DefaultNamespace]</option>
                            @foreach (var item in Model.AvailableNamespaces)
                            {
                                <option value="@item.Id">@item.Name (/@item.Name/{code})</option>
                            }
                            @if (Model.NewLink.NamespaceId.HasValue &&
                                !Model.AvailableNamespaces.Any(item => item.Id == Model.NewLink.NamespaceId))
                            {
                                <option value="@Model.NewLink.NamespaceId" data-unavailable="true">
                                    @L["Namespaces:SelectionUnavailable"]
                                </option>
                            }
                        </select>
                        <div id="namespace-options-status" class="form-text" role="status" aria-live="polite">
                            @L[!Model.HasNamespacePermission ? "Namespaces:SelectionPermissionRequired" :
                                !Model.Capabilities.NamespacesEnabled ? "Namespaces:UnavailableHelp" :
                                "Namespaces:SelectDomainHelp"]
                        </div>
                        <button type="button" id="namespace-options-retry" class="btn btn-sm btn-link px-0" hidden>
                            @L["Retry"]
                        </button>
                        <span asp-validation-for="NewLink.NamespaceId" class="text-danger"></span>
                        <noscript>
                            <button type="submit" asp-page-handler="RefreshNamespaces" formnovalidate class="btn btn-sm btn-outline-secondary">
                                @L["Namespaces:Refresh"]
                            </button>
                        </noscript>
                    </div>
                    <div class="col-lg-4">
                        <div class="form-check mt-lg-4">
                            <input asp-for="NewLink.UseRootPath"
                                   class="form-check-input"
                                   disabled="@(!Model.Capabilities.CanCreateRootLink && !Model.NewLink.UseRootPath)"
                                   aria-describedby="root-path-help" />
                            <label asp-for="NewLink.UseRootPath" class="form-check-label">@L["RootPath:Option"]</label>
                        </div>
                        <div id="root-path-help" class="form-text">
                            @L[Model.Capabilities.CanCreateRootLink ? "RootPath:QuotaHelp" : "RootLinkQuota:InputUnavailable"]
                        </div>
                        <span asp-validation-for="NewLink.UseRootPath" class="text-danger"></span>
                    </div>
                    <div class="col-lg-2">
                        <label asp-for="NewLink.CustomCode" class="form-label">@L["CustomCode"]</label>
                        <input asp-for="NewLink.CustomCode"
                               class="form-control"
                               disabled="@(!Model.Capabilities.CanUseCustomCode)"
                               aria-describedby="custom-code-help" />
                        @if (!Model.Capabilities.CanUseCustomCode)
                        {
                            <div id="custom-code-help" class="form-text">
                                @L["CustomCodeQuota:InputUnavailable"]
                            </div>
                        }
                        <span asp-validation-for="NewLink.CustomCode" class="text-danger"></span>
                    </div>
                    <div class="col-lg-2">
                        <label asp-for="NewLink.Title" class="form-label">@L["Title"]</label>
                        <input asp-for="NewLink.Title" class="form-control" />
                    </div>
                    <div class="col-lg-2">
                        <label asp-for="NewLink.ExpiresAt" class="form-label">@L["ExpiresAtUtc"]</label>
                        <input asp-for="NewLink.ExpiresAt" type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-12">
                        <button type="submit" id="create-short-link-button" class="btn btn-primary" disabled="@(!Model.CanCreateSelectedPath)">
                            <i class="fa fa-plus me-1"></i>@L["Create"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                <tr>
                    <th>@L["ShortUrl"]</th>
                    <th>@L["TargetUrl"]</th>
                    <th>@L["Status"]</th>
                    <th>@L["ExpiresAt"]</th>
                    @if (Model.CanViewStatistics)
                    {
                        <th class="text-end">@L["Visits"]</th>
                    }
                    <th class="text-end">@L["Actions"]</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="@(Model.CanViewStatistics ? 6 : 5)" class="text-center text-muted py-5">@L["NoShortLinks"]</td>
                    </tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Code</div>
                            <a href="@item.ShortUrl" target="_blank" rel="noopener noreferrer">@item.ShortUrl</a>
                            <partial name="_ShortLinkPath" model="item" />
                        </td>
                        <td class="text-truncate" style="max-width: 340px">
                            @if (!string.IsNullOrWhiteSpace(item.Title))
                            {
                                <div class="fw-semibold">@item.Title</div>
                            }
                            <a href="@item.TargetUrl" target="_blank" rel="noopener noreferrer">@item.TargetUrl</a>
                        </td>
                        <td>
                            <span class="badge @(item.Status == ShortLinkStatus.Active ? "bg-success" : "bg-secondary")">
                                @L[$"Status:{item.Status}"]
                            </span>
                        </td>
                        <td>@(item.ExpiresAt?.ToString("u") ?? L["Never"])</td>
                        @if (Model.CanViewStatistics)
                        {
                            <td class="text-end">@item.TotalVisitCount</td>
                        }
                        <td class="text-end text-nowrap">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary copy-short-link"
                                    data-url="@item.ShortUrl"
                                    data-copied-message="@L["Copied"]">
                                @L["Copy"]
                            </button>
                            <a asp-page-handler="QrCode"
                               asp-route-id="@item.Id"
                               target="_blank"
                               class="btn btn-sm btn-outline-secondary">@L["QrCode"]</a>
                            @if (Model.CanViewStatistics)
                            {
                                <a asp-page="./Statistics"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info">@L["Statistics"]</a>
                            }
                            @if (Model.CanUpdate)
                            {
                                <a asp-page="./Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">@L["Edit"]</a>
                                <form method="post" asp-page-handler="SetStatus" class="d-inline">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="concurrencyStamp" value="@item.ConcurrencyStamp" />
                                    <input type="hidden"
                                           name="status"
                                           value="@(item.Status == ShortLinkStatus.Active ? ShortLinkStatus.Disabled : ShortLinkStatus.Active)" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning">
                                        @(item.Status == ShortLinkStatus.Active ? L["Disable"] : L["Activate"])
                                    </button>
                                </form>
                            }
                            @if (Model.CanDelete)
                            {
                                <form method="post"
                                      asp-page-handler="Delete"
                                      class="d-inline delete-short-link-form">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="concurrencyStamp" value="@item.ConcurrencyStamp" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["Delete"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<abp-script src="/Pages/Public/ShortLinks/Index.js" />
