DOMAIN=links.example.com
SHORTLINK_IMAGE=ghcr.io/your-org/shortlink:latest

POSTGRES_DB=shortlink
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=replace-with-a-long-random-password

REDIS_PASSWORD=replace-with-a-long-random-password
VISITOR_HASH_KEY=replace-with-at-least-32-random-characters
STRING_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=ShortLink
SMTP_ENABLE_SSL=true

OPENIDDICT_CERTIFICATE_PASSWORD=replace-with-a-long-random-password
