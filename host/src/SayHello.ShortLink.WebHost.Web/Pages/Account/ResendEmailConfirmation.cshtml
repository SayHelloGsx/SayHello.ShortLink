@page
@using Microsoft.Extensions.Localization
@using SayHello.ShortLink.WebHost.Localization
@model SayHello.ShortLink.WebHost.Web.Pages.Account.ResendEmailConfirmationModel
@inject IStringLocalizer<WebHostResource> L

<div class="card mt-3 shadow-sm rounded">
    <div class="card-body p-5">
        <h1 class="h4">@L["ResendConfirmation"]</h1>
        @if (Model.IsSent)
        {
            <div class="alert alert-success">@L["ResendConfirmation:GenericResult"]</div>
        }
        <form method="post">
            <div class="mb-3">
                <label asp-for="EmailAddress" class="form-label">@L["EmailAddress"]</label>
                <input asp-for="EmailAddress" class="form-control" />
                <span asp-validation-for="EmailAddress" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">@L["Send"]</button>
        </form>
    </div>
</div>
